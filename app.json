{
  "expo": {
    "name": "KarolayJeansMovilApp",
    "slug": "karolay-jeans-movil-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "karolayjeansmovil",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.karolayjeans.movil"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.karolayjeans.movil",
      "permissions": [
        "VIBRATE",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir a KarolayJeansMovil usar la cámara para escanear códigos de barras"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9fb55813-9dde-4a70-aebf-d9b0c09783cb"
      }
    },
    "owner": "carlosretuerto"
  }
}
